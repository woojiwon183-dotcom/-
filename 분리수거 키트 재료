아두이노 C++ 코드
#include <Servo.h>

// 핀 번호 정의 (이전 회로 구성 기준)
const int TRIG_PIN = 2;
const int ECHO_PIN = 3;
const int SERVO_PIN = 9;

Servo myServo;

void setup() {
  Serial.begin(9600);          // 시리얼 모니터 및 통신 속도 설정
  pinMode(TRIG_PIN, OUTPUT);   // 트리거 핀 출력 설정
  pinMode(ECHO_PIN, INPUT);    // 에코 핀 입력 설정
  
  myServo.attach(SERVO_PIN);   // 서보모터 핀 연결
  myServo.write(0);            // 서보모터 초기 위치(0도)
}

void loop() {
  // 초음파 센서 트리거 신호 출력
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  // 초음파 반사 신호 수신 시간 측정 (단위: microsecond)
  long duration = pulseIn(ECHO_PIN, HIGH);
  
  // 시간을 거리(cm)로 환산
  int distance = duration * 0.034 / 2;

  // 시리얼 모니터로 측정 거리 확인
  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  // 물체가 10cm 이내로 접근한 경우
  if (distance > 0 && distance <= 10) {
    myServo.write(90); // 분류 동작 (90도 회전)
    delay(1000);       // 1초간 유지
  } else {
    myServo.write(0);  // 대기 위치 (0도 복귀)
  }

  delay(100); // 0.1초 간격 측정
}
